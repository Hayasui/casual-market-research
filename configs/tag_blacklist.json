{
  "schema_version": "1.0.0",
  "updated_date": "2026-11-26",
  "primary_domains": [
    {"id": "food_dining", "label_zh": "美食餐饮"},
    {"id": "home_renovation", "label_zh": "居家改造"},
    {"id": "hotel_business", "label_zh": "酒店商业"},
    {"id": "farm_countryside", "label_zh": "农牧乡村"},
    {"id": "fashion_styling", "label_zh": "时尚造型"},
    {"id": "town_community", "label_zh": "城镇社区"},
    {"id": "fantasy_realm", "label_zh": "奇幻异界", "full_only": true},
    {"id": "craft_workshop", "label_zh": "器物工坊", "full_only": true},
    {"id": "care_medical", "label_zh": "医养照护", "full_only": true}
  ],
  "tag_format": {
    "tag_id_regex": "^[a-z][a-z0-9_]{1,39}$",
    "label_zh_recommended_max_chars": 6,
    "label_zh_hard_max_chars": 8,
    "require_label_en": true,
    "require_definition": true,
    "require_include_and_exclude_examples": true
  },
  "slots": {
    "pass1_free_tags_per_product": {
      "min": 5,
      "max": 8
    },
    "pass2_final_tags_per_product": {
      "min": 2,
      "max": 3
    },
    "axes": {
      "theme_primary": {
        "label_zh": "主题材",
        "required": true,
        "min": 1,
        "max": 1,
        "badge_color_role": "theme",
        "guidance": "只记录玩家反复经营、修复或处理的对象，例如「烘焙店」「海滨餐厅」。一级取自 primary_domains，填写表中的 id。",
        "allow_parent_domain": true,
        "require_parent_domain": true
      },
      "presentation": {
        "label_zh": "呈现形式",
        "required": true,
        "min": 1,
        "max": 1,
        "badge_color_role": "presentation",
        "guidance": "只记录商店实机棋盘与主场景可指认的呈现风格，按「人物与物体比例、渲染质感与笔触光影、色彩饱和度、空间立体度」四项可见特征锚定。绘制型分平涂图标、欧美绘本卡通、东方勾线彩绘；立体型分圆润亮彩立体、细材质立体。不反推渲染技术；未经实证不得在 tag_id 或 label_zh 中使用 2D/3D。"
      },
      "fusion_secondary": {
        "label_zh": "副题材或玩法融合",
        "required": false,
        "min": 0,
        "max": 1,
        "badge_color_role": "fusion",
        "guidance": "副题材或融合玩法有独立操作或进度时才填写，例如家园装修、商业经营、角色换装。"
      }
    }
  },
  "narrative_intensity": {
    "label_zh": "叙事强度",
    "required": true,
    "counts_toward_final_tags": false,
    "controlled_enum": [
      "重剧情",
      "轻剧情",
      "无剧情"
    ],
    "motif_linkage": {
      "无剧情": "must_be_null",
      "轻剧情": "optional",
      "重剧情": "must_be_non_null"
    },
    "evidence_policy": {
      "high_reliability_types": [
        "store_screenshot",
        "st_review",
        "web_wiki_review"
      ],
      "moderate_reliability_types": [
        "store_desc"
      ],
      "forbidden_sole_types": [
        "ad_creative"
      ],
      "min_evidence_for_story": 2,
      "min_high_reliability_for_story": 1,
      "min_evidence_for_none": 1
    }
  },
  "narrative_motif": {
    "label_zh": "叙事类型",
    "required": false,
    "min": 0,
    "max": 1,
    "controlled_enum_size": {
