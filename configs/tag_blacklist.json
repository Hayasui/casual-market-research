    "allowed_only_for_verified_new_releases": true,
    "pilot_scope_meaning": "仅表示由近 12 个月已核验新品引入的试点单例，不代表休闲全盘新题材",
    "revert_to_false_on_full_hits_min": 2
  },
  "visual_unit_policy": {
    "controlled_enum": ["board_and_scene_pair", "gameplay_board", "main_scene", "promo_or_portrait_only"],
    "forbidden_high_conf_units": ["promo_or_portrait_only"],
    "preferred_unit_by_subgenre": {
      "merge": "board_and_scene_pair",
      "match_3": "board_and_scene_pair",
      "hybrid_puzzle": "gameplay_board",
      "simulation": "main_scene"
    },
    "require_full_scan_before_fallback": true,
    "require_fallback_reason_when_not_preferred": true,
    "required_presentation_evidence_fields": ["screenshot_index", "visual_unit", "primary_visual_region"]
  },
  "evidence_rules": {
    "valid_evidence_types": [
      "store_desc",
      "store_screenshot",
      "st_review",
      "web_wiki_review",
      "ad_creative"
    ],
    "non_marketing_evidence_types": [
      "store_desc",
