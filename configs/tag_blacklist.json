      "st_review",
      "web_wiki_review"
    ],
    "min_non_marketing_evidence_per_final_tag": 1,
    "forbid_marketing_only_final_tag": true,
    "presentation_slot_requires_visual_check": true,
    "max_evidence_quote_words": 40,
    "require_excluded_near_tags": true,
    "valid_confidence_levels": [
      "high",
      "medium",
      "low"
    ],
    "allowed_adjudication_owners": ["main_session", "human"],
    "low_confidence_fallback_policy": "缺少一级非买量叙事原证时降级为无剧情并置 narrative_motif 为 null"
  },
