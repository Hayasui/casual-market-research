  "vocab_capacity": {
    "catalog_max": null,
    "active_vocab_note": "激活词表沿用 mode_thresholds 的 pilot 12 到 20、full 25 到 40；全库候选目录不设硬顶"
  },
  "mode_thresholds": {
    "pilot": {
      "vocab_min": 12,
      "vocab_max": 20,
      "blind_sample_size": 5,
      "blind_sample_stratification": "1头部强剧情 + 2题材易混/脏标签样本 + 2近12月首发新品或低置信样本",
      "theme_primary_agreement_min": 0.80,
      "presentation_agreement_min": 0.80,
      "tag_set_overlap_min": 0.75,
      "overlap_formula": "|A ∩ B| / |A ∪ B|",
      "max_unresolved_low_confidence": 0,
      "adjudication_owner": "main_session",
      "emerging_singleton_allowed_for_new_releases": true,
      "signoff_method": "dialogue_table_approval",
      "signoff_artifact": "research/data/tag_vocab_draft.md"
    },
    "full": {
      "vocab_min": 25,
      "vocab_max": 40,
      "blind_sample_size": 12,
      "blind_sample_per_subgenre": 3,
      "blind_sample_stratification": "每品类 3 个：1 头部老品 + 1 跨题材易混品 + 1 新品或低置信样本",
      "theme_primary_agreement_min": 0.80,
      "presentation_agreement_min": 0.80,
      "tag_set_overlap_min": 0.75,
      "overlap_formula": "|A ∩ B| / |A ∪ B|",
      "max_unresolved_low_confidence": 0,
      "adjudication_owner": "main_session",
      "emerging_singleton_allowed_for_new_releases": true,
      "freeze_existing_pilot_tag_ids_on_expand": true,
      "signoff_method": "dialogue_table_approval",
      "signoff_artifact": "research/data/tag_vocab_draft.md"
    }
  },
  "blind_retest_protocol": {
    "disclosure_label": "同模型独立上下文重测（度量词表歧义与输出稳定性，不等于跨模型交叉验证）",
    "subagent_isolation": "remote",
    "subagent_model": "inherit_main",
    "forbid_model_override": true,
    "forbid_unverified_model_names_in_disclosure": true,
    "allowed_disclosures": [
      "同模型独立上下文重测",
      "同模型独立上下文重测（度量词表歧义与输出稳定性，不等于跨模型交叉验证）",
      "文本与视觉分通道独立上下文重测"
    ],
    "unverified_model_name_patterns": ["sonnet", "opus", "haiku", "claude", "gpt-", "gemini", "deepseek", "qwen"],
    "model_inheritance_basis": "2026-11-26 当前云端宿主实测确认：母子代理运行同一模型，指定非自身模型参数既不改变执行模型也留不下可核记录；宿主换版本须重新实测。",
    "strip_input_fields": [
      "pass1_free_tags",
      "pass2_final_tags",
      "pass2_rationale",
      "st_game_iq_theme",
      "st_game_iq_art_style",
      "st_game_iq_tags",
      "narrative_intensity",
      "narrative_motif",
      "narrative_evidence"
    ],
    "require_falsification_first_prompt": true,
    "falsification_instruction": "对每款抽检产品，先找出 2 个最易混淆、必须排除的近义受控词并给出原文或截图反证，再锁定剩余的 2–3 个受控 Tag。"
  }
